/* --------------------------------------------------------------------------
   Hero
   -------------------------------------------------------------------------- */
.hero__title {
    font-size: var(--text-hero);
    letter-spacing: -0.035em;
    line-height: 1.06;
    color: #000;
}

.hero__title sup {
    font-size: 0.35em;
    top: -1.3em;
    font-weight: 400;
}

.hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--base-500);
}

/* --------------------------------------------------------------------------
   Marquee
   -------------------------------------------------------------------------- */
.marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-block: 3rem 1rem;
    /* Fade the strip out at both ends */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
}

.marquee__track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 1.8rem;
    white-space: nowrap;
    will-change: transform;
    animation: marquee 42s linear infinite;
}

@media (min-width: 1024px) {
    .marquee__track {
        gap: 4rem;
    }
}

.marquee__item {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--base-500);
}

@keyframes marquee {
    from {
        transform: translateX(0);
    }

    to {
        transform: translateX(-50%);
    }
}

/* --------------------------------------------------------------------------
   Media
   -------------------------------------------------------------------------- */
.media {
    display: block;
    width: 100%;
    overflow: hidden;
    background-color: var(--base-200);
}

.media img {
    width: 100%;
    transition: filter 0.6s ease, transform 0.6s ease;
}

.media--muted img {
    filter: grayscale(1);
}

.media--muted:hover img {
    filter: grayscale(0);
}

/* Crop paired photographs to a common frame so the grid lines up */
.media--cover img {
    aspect-ratio: 16 / 9;
    object-fit: cover;
}

.media__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--base-500);
}

.media-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 1.5rem;
}

@media (min-width: 768px) {
    .media-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* --------------------------------------------------------------------------
   Numbered list (features)
   -------------------------------------------------------------------------- */
.numbered {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--base-200);
    border-bottom: 1px solid var(--base-200);
}

.numbered li + li {
    border-top: 1px solid var(--base-200);
}

.numbered__item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding-block: 1rem;
}

@media (min-width: 1024px) {
    .numbered__item {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .numbered__desc {
        grid-column: span 2;
    }
}

.numbered__title {
    display: flex;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--base-900);
}

.numbered__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--base-500);
    padding-top: 0.2em;
    flex: none;
}

.numbered__desc {
    font-size: 1rem;
    color: var(--base-700);
    margin: 0;
}

/* --------------------------------------------------------------------------
   Link rows (resources)
   -------------------------------------------------------------------------- */
.rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--base-200);
}

.rows + .rows {
    border-top: 0;
}

.row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--base-200);
    text-decoration: none;
    color: inherit;
}

.row__title {
    font-family: var(--font-display);
    font-size: var(--text-row);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 0.5rem;
    color: var(--base-900);
    transition: color 0.4s ease;
}

.row:hover .row__title {
    color: var(--accent-500);
}

.row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--base-500);
}

.row__arrow {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--base-300);
    transition: color 0.4s ease, transform 0.4s ease;
}

.row:hover .row__arrow {
    color: var(--base-900);
    transform: translate(0.25rem, -0.25rem);
}

@media (min-width: 1024px) {
    .row__arrow {
        width: 3rem;
        height: 3rem;
    }
}

/* Subsection heading inside a resource group */
.group-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--base-500);
    margin: 3rem 0 0.75rem;
}

.group-title:first-child {
    margin-top: 0;
}

/* --------------------------------------------------------------------------
   Videos
   -------------------------------------------------------------------------- */
.videos {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
}

@media (min-width: 768px) {
    .videos {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

.video__frame {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    background-color: var(--base-200);
}

.video__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
}

.video__caption {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    color: var(--base-700);
}

/* --------------------------------------------------------------------------
   Call to action
   -------------------------------------------------------------------------- */
.cta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

@media (min-width: 768px) {
    .cta {
        flex-direction: row;
    }

    .cta__aside {
        width: 50%;
        border-left: 2px solid var(--base-200);
        padding-left: 1rem;
    }
}

.cta__title {
    font-size: clamp(1.5rem, 1rem + 2vw, 3rem);
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: #000;
}

.cta__aside {
    font-size: 0.875rem;
    font-weight: 500;
    color: #000;
    margin: 0;
}

.cta__aside a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
}

.cta__aside a:hover {
    color: var(--accent-500);
}

/* --------------------------------------------------------------------------
   Footer
   -------------------------------------------------------------------------- */
.site-footer {
    background-color: var(--base-50);
    overflow: hidden;
}

.footer__rows {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--base-200);
}

.footer__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding-block: 2rem;
}

.footer__row + .footer__row {
    border-top: 1px solid var(--base-200);
}

@media (min-width: 768px) {
    .footer__row {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

.footer__heading {
    font-size: var(--text-section);
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--base-900);
}

.footer__links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    margin-top: 0.5rem;
    align-content: start;
}

@media (min-width: 768px) {
    .footer__links {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin-top: 0;
    }
}

.footer__links a {
    font-size: 0.875rem;
    color: var(--base-700);
    text-decoration: none;
    transition: color 0.5s ease;
}

.footer__links a:hover {
    color: var(--accent-500);
}

.footer__base {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding-top: 2rem;
    /* Clear the floating dock */
    padding-bottom: 7rem;
}

@media (min-width: 1024px) {
    .footer__base {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

.footer__fine {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--base-700);
    margin: 0;
}

.footer__fine a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
}

.footer__fine a:hover {
    color: var(--accent-500);
}

@media (min-width: 1024px) {
    .footer__base--end {
        text-align: right;
    }
}

/* --------------------------------------------------------------------------
   Scroll reveal
   -------------------------------------------------------------------------- */
.reveal {
    overflow: hidden;
}

.reveal > * {
    transform: translateY(1.5rem);
    opacity: 0;
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1),
        opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
}

.reveal.is-visible > * {
    transform: none;
    opacity: 1;
}

/* Without JS the observer never runs, so never hide anything */
.no-js .reveal > * {
    transform: none;
    opacity: 1;
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    .marquee__track {
        animation: none;
    }

    .reveal > * {
        transform: none;
        opacity: 1;
        transition: none;
=======
    /* Grid is already single-column; explicit override prevents
       any future two-column desktop change breaking mobile. */
    .features-grid,
    .videos-grid {
        grid-template-columns: 1fr;
>>>>>>> 720115b89e5dd0095f10eb70936de561146c7b78
    }
    /* Tighten header nav spacing on tablet */
    .header-nav {
        gap: 10px;
    }
    .header-nav a {
        padding: 6px 8px;
        font-size: 0.95rem;
    }
}

/* 480px breakpoint – small phone screens */
@media (max-width: 480px) {
    /* Further reduce headline to prevent text overflow */
    .section-headline {
        font-size: 2rem;
    }
    /* Reduce container padding to maximise content area */
    .container {
        padding: 24px 16px;
    }
    /* Stack header padding on very small screens */
    .site-header {
        padding: 12px 16px;
    }
    /* Stack CTA buttons vertically on small screens */
    .button-container {
        flex-direction: column;
        align-items: center;
    }
    /* Make resource table cells smaller to fit narrow screens */
    .resource-table th,
    .resource-table td {
        padding: 8px 8px;
        font-size: 0.9rem;
    }
}

/* Accessibility: respect user preference to reduce motion.
   Disables smooth scroll and CSS transitions for users who have
   set "Reduce Motion" in their OS accessibility settings. */
@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }
    .button,
    .header-nav a,
    .skip-link {
        transition: none;
    }
}

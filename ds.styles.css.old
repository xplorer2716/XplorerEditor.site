/* ─────────────────────────────────────────────────────────────
   6. HERO SECTION
   The screenshot is the hero – it shows the product immediately.
   Subtle box-shadow lifts it off the page without heavy decoration.
   Square corners (border-radius: 0) match the utilitarian UI style
   of the software itself.
   ───────────────────────────────────────────────────────────── */
.hero-image-wrapper {
    margin-top: 40px;
    padding: 0 20px;
}

.hero-image {
    max-width: 100%;
    height: auto;
    border-radius: 0; /* square corners to match the software UI aesthetic */
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    display: block;
    margin: 0 auto;
}


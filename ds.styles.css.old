/*
 * ═══════════════════════════════════════════════════════════════
 *  Xplorer Editor – Main Stylesheet
 *  Design philosophy: Apple-inspired, clean, content-first.
 *  Uses system font stacks, CSS custom properties for theming,
 *  and a mobile-first responsive approach.
 * ═══════════════════════════════════════════════════════════════
 *  Table of contents
 *  1.  Custom properties (design tokens)
 *  2.  Global reset & base styles
 *  3.  Accessibility utilities (skip-link, sr-only, focus)
 *  4.  Site header & navigation
 *  5.  Layout containers & sections
 *  6.  Hero section
 *  7.  Product description section
 *  8.  Main features section
 *  9.  CTA buttons
 * 10.  Videos section
 * 11.  Resources section (tables, images)
 * 12.  Site footer
 * 13.  Responsive breakpoints (≤768px, ≤480px)
 *      Performance: prefers-reduced-motion override
 * ═══════════════════════════════════════════════════════════════
 */

/* ─────────────────────────────────────────────────────────────
   1. CUSTOM PROPERTIES (DESIGN TOKENS)
   Centralising colours, font stack, and spacing here makes
   global theme changes a one-line edit.
   Color palette rationale:
     --background-color   #f5f5f7  Apple Light Grey – neutral, easy on the eye
     --card-background    #ffffff  Pure white cards contrast the grey page bg
     --primary-text       #1d1d1f  Near-black – high contrast (>7:1 on white)
     --secondary-text     #6e6e73  Mid-grey – sufficient contrast on white (4.6:1)
     --accent-color       #007aff  Apple Blue – universally recognised as "action"
     --divider-color      #d2d2d7  Subtle divider, does not compete with content
     --header-bg          #373536  Very dark grey – anchors page; avoids pure black
     --videos-section-bg  #f5f5f7  Same as page bg – seamless blending for this section
   ───────────────────────────────────────────────────────────── */
:root {
    --background-color:     #f5f5f7;
    --videos-section-bg:    #f5f5f7; /* background used for the videos section and table headers */
    --card-background-color:#ffffff;
    --primary-text-color:   #1d1d1f;
    --secondary-text-color: #6e6e73;
    --accent-color:         #007aff;
    --accent-color-dark:    #0062cc; /* darker shade for hover/focus states */
    --divider-color:        #d2d2d7;
    --header-bg:            #373536;
    --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                   "Helvetica Neue", Arial, sans-serif;
}

/* ─────────────────────────────────────────────────────────────
   2. GLOBAL RESET & BASE STYLES
   box-sizing: border-box on all elements prevents unexpected
   overflow when adding padding/border to sized elements.
   scroll-behavior: smooth enables smooth anchor-link scrolling
   for the nav links (disabled via prefers-reduced-motion below).
   ───────────────────────────────────────────────────────────── */
*, *::before, *::after {
    box-sizing: border-box;
}

html {
    /* Smooth scroll for anchor navigation (#main-features, #videos, etc.) */
    scroll-behavior: smooth;

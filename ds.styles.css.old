/* --------------------------------------------------------------------------
   Top bar
   -------------------------------------------------------------------------- */
.topbar {
    padding-block: 1.5rem;
}

.topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.wordmark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: #000;
    text-decoration: none;
}

.wordmark sup {
    font-size: 0.5em;
    top: -0.7em;
    font-weight: 400;
}

.topbar__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--base-500);
    text-align: right;
}

/* --------------------------------------------------------------------------
   Floating dock navigation
   -------------------------------------------------------------------------- */
.dock {
    position: fixed;
    inset-inline: 0;
    bottom: 1.25rem;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
    pointer-events: none;
}

.dock__inner {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: var(--radius);
    background-color: var(--base-900);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
    max-width: 100%;
}

.dock__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--dock-height);
    height: var(--dock-height);
    flex: none;
    border-radius: calc(var(--radius) - 0.25rem);
    background-color: var(--base-800);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    text-decoration: none;
}

.dock__link {
    display: flex;
    align-items: center;
    height: var(--dock-height);
    padding-inline: 0.875rem;
    border-radius: calc(var(--radius) - 0.25rem);
    background-color: var(--base-800);
    color: #fff;
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.3s ease;
}

.dock__link:hover,
.dock__link:focus-visible {
    background-color: var(--base-950);
}

.dock__cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: var(--dock-height);
    padding-inline: 1rem;
    border-radius: calc(var(--radius) - 0.25rem);
    background-color: var(--base-50);
    color: var(--base-900);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.3s ease;
}

.dock__cta:hover,
.dock__cta:focus-visible {
    background-color: var(--base-200);
}

@media (max-width: 640px) {

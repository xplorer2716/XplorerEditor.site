/* ─────────────────────────────────────────────────────────────
   3. ACCESSIBILITY UTILITIES
   ───────────────────────────────────────────────────────────── */

/* Skip-to-main-content link (WCAG 2.4.1 – Bypass Blocks)
   Visually hidden by default; revealed on :focus so keyboard
   users can skip repeated navigation. Positioned absolutely
   to appear at the top-left of the viewport when focused.
   Uses a solid accent background so it is clearly readable. */
.skip-link {
    position: absolute;
    top: -100%;         /* push off-screen when not focused */
    left: 0;
    z-index: 9999;
    background: var(--accent-color);
    color: #fff;
    padding: 10px 18px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 0 0 6px 0;
    transition: top 0.15s ease;
}
.skip-link:focus {
    top: 0; /* slide into view when focused */
    outline: 3px solid #fff;
    outline-offset: 2px;
}

/* Screen-reader only utility – hides content visually while
   keeping it accessible to assistive technologies and search
   engines. Do NOT use display:none or visibility:hidden as those
   remove content from the accessibility tree.
   Applied to: the <h1> site-title (logo provides visual heading),
   and to the hero section's visually-implicit heading. */
.sr-only,
.site-title {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0 0 0 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
}

/* Global focus style – WCAG 2.4.7 (Focus Visible)
   Browsers have inconsistent default focus rings; we define one
   that is clearly visible at WCAG-compliant contrast on any
   background. The 2px offset prevents the outline from merging
   with the element border. */
:focus-visible {
    outline: 3px solid var(--accent-color);
    outline-offset: 2px;
    border-radius: 3px;
}

/* ─────────────────────────────────────────────────────────────
   4. SITE HEADER & NAVIGATION
   Dark (#373536) banner matches the Xplorer UI screenshot colours,
   creating a cohesive first impression. The logo (header.jpg) acts
   as the primary brand mark. Navigation sits below the logo using
   flex column layout.
   ───────────────────────────────────────────────────────────── */
.site-header {
    background-color: var(--header-bg);
    padding: 15px 30px;
    display: flex;
    flex-direction: column; /* stack logo above nav */
    align-items: flex-start; /* left-align both logo and nav */
}

.header-logo {
    /* Let the image scale naturally; width is controlled by the
       inline JS that also sets header min-height. */
    width: auto;
    max-width: 100%; /* prevent overflow on very small screens */
    display: block;
}

/* Navigation: horizontal row of text links inside the dark header */
.header-nav {
    margin-top: 12px; /* visual gap between logo and nav links */
    display: flex;
    gap: 18px;
    align-items: center;
    flex-wrap: wrap; /* wrap to next line on narrow viewports */
    align-self: flex-start;
    margin-left: 0;
}

/* Nav links: white text on dark background – clear contrast.
   Slight background on hover/focus gives tactile feedback. */
.header-nav a {
    color: #ffffff;
    text-decoration: none;
    font-weight: 300;
    padding: 6px 10px;
    border-radius: 6px;
    transition: background-color 0.15s ease, color 0.15s ease;
}
.header-nav a:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
}
/* :focus-visible inherits the global rule but we override the color
   so the ring is visible against the dark header background. */
.header-nav a:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 2px;
}


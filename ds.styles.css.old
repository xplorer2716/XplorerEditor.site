}
.feature-item::before {
    content: '✓';
    color: var(--accent-color);
    font-weight: bold;
    margin-right: 10px;
}

/* ─────────────────────────────────────────────────────────────
   9. CTA BUTTONS
   Two button styles: primary (filled blue) for the main action
   (Download) and secondary (light grey) for supporting actions
   (GitHub). 8px border-radius is softer than pill-shaped but
   more refined than a square.
   ───────────────────────────────────────────────────────────── */
.button-container {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 40px;
    flex-wrap: wrap; /* stack gracefully on very narrow screens */
}

.button {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: background-color 0.2s ease, transform 0.1s ease;
}

/* Primary = blue filled; white text passes WCAG AA on #007aff (3.5:1)
   and on #0062cc (4.6:1 – hover state). */
.button-primary {
    background-color: var(--accent-color);
    color: #fff;
}
.button-primary:hover {
    background-color: var(--accent-color-dark);
}
.button-primary:focus-visible {
    outline: 3px solid var(--accent-color-dark);
    outline-offset: 3px;
}

/* Secondary = light grey; near-black text for strong contrast */
.button-secondary {
    background-color: #e5e5ea;
    color: var(--primary-text-color);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px; /* space between GitHub icon and text */
}
.button-secondary:hover {
    background-color: #dcdce1;
}

/* ─────────────────────────────────────────────────────────────
   10. VIDEOS SECTION
   Grey background matches the page colour – videos sit in a
   visually unified band. Single-column stack keeps each video
   at a comfortable viewing size.
   The .video-wrapper uses the classic padding-bottom percentage
   trick to maintain a 16:9 aspect ratio regardless of container
   width; the iframe fills this box absolutely.
   ───────────────────────────────────────────────────────────── */
.videos-section {
    background-color: var(--videos-section-bg);
    padding-top: 20px;
    padding-bottom: 20px;
    border-top: 1px solid var(--divider-color);
}

.videos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 20px;
}

/* Responsive 16:9 aspect-ratio container for iframes.
   padding-bottom: 56.25% = 9/16 = 56.25% of the container width. */
.video-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 ratio */
    height: 0;
    overflow: hidden;
}
.video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0; /* remove default iframe border */
}

.video-caption {
    margin-top: 8px;
    color: var(--secondary-text-color);
    text-align: center;
    font-size: 0.95rem;
}

/* ─────────────────────────────────────────────────────────────
   11. RESOURCES SECTION
   White background for the downloadable-docs section.
   Tables give a structured, professional look to file lists.
   Download links use the accent colour so they stand out without
   heavy decoration.
   ───────────────────────────────────────────────────────────── */
.resources-section {
    padding: 40px 0;
    background-color: var(--card-background-color);
    border-top: 1px solid var(--divider-color);
}

/* Sub-sections (Manuals, Hardware, Sound programming) */
.resource-subsection {
    margin: 30px 0;
}

/* Subsection headings (h3): smaller than section headline but
   clearly hierarchical (h2 > h3 > h4). */
.subsection-headline {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 12px 0;
    color: var(--primary-text-color);
}

/* Override description-text in resources: full width, left-aligned */
.resources-section .description-text {
    max-width: 100%;
    margin: 0 0 1em 0;
    text-align: left;
}

/* Resource table: clean borders, adequate cell padding */
.resource-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 12px;
}
.resource-table th,
.resource-table td {
    border: 1px solid var(--divider-color);
    padding: 10px 12px;
    text-align: left;
    vertical-align: middle;
}
/* Table header cells: light grey fill matches page background */
.resource-table thead th {
    background-color: var(--videos-section-bg);
    color: var(--primary-text-color);
    font-weight: 700;
}

/* Download links: accent colour stands out; underline on hover
   provides extra affordance. */
.download-link {
    color: var(--accent-color);
    font-weight: 600;
    text-decoration: none;
}
.download-link:hover {
    text-decoration: underline;
}

/* Full-width resource images (e.g. LFO-to-BPM chart) */
.resource-img {
    width: 100%;
    height: auto;
    display: block;
    max-width: 100%;
    margin-top: 12px;
}

/* Small inline image inside a table cell (encoder replacement) */
.resource-inline-img {
    display: block;
    max-width: 100%;
    height: auto;
    margin-top: 8px;
    border-radius: 4px;
}

/* ─────────────────────────────────────────────────────────────
   12. SITE FOOTER
   Dark background mirrors the header, providing visual
   bookending of the page. White text on #373536 achieves a
   contrast ratio of ~9:1 (WCAG AAA).
   A top border ("liseret") separates it from the last section.
   ───────────────────────────────────────────────────────────── */
.site-footer {
    background-color: var(--header-bg); /* mirror the header colour */
    color: #ffffff;
    padding: 30px 0;
    border-top: 1px solid var(--divider-color); /* thin separator line */
}
.site-footer a {
    color: #ffffff;
    text-decoration: underline;
}
.site-footer a:hover {
    opacity: 0.85;
}
.site-footer .container {
    padding: 0 20px;
}


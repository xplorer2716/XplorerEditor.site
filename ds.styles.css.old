/* ==========================================================================
   Xplorer — Oberheim Xpander & Matrix-12 Editor
   Minimal / typographic stylesheet.
   Design language inspired by flexdigital.io: Geist + Inter, neutral base
   scale, generous breathing room, hairline dividers, floating dock nav.
   ========================================================================== */

/* --------------------------------------------------------------------------
   Design tokens
   -------------------------------------------------------------------------- */
:root {
    /* Neutral base scale */
    --base-50: #f2f2f3;
    --base-100: #e7e8e9;
    --base-200: #cdcfd0;
    --base-300: #b6b8ba;
    --base-500: #84878a;
    --base-700: #545759;
    --base-800: #3c3d3f;
    --base-900: #242526;
    --base-950: #111212;

    /* Warm accent, picked up from the Oberheim wood cheeks */
    --accent-400: #eb9075;
    --accent-500: #e67451;

    --font-display: "Geist", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --font-mono: "Geist Mono", ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;

    --radius: 0.5rem;
    --gutter: 2rem;
    --dock-height: 3.5rem;

    /* Fluid type scale */
    --text-hero: clamp(1.875rem, 1rem + 3.1vw, 3.75rem);
    --text-section: clamp(2.25rem, 1.55rem + 2.4vw, 3.75rem);
    --text-row: clamp(1.5rem, 1.15rem + 1.5vw, 2.25rem);
    --text-lead: clamp(1.125rem, 1.05rem + 0.3vw, 1.25rem);
}

@media (min-width: 1024px) {
    :root {
        --gutter: 6rem;
    }
}

/* --------------------------------------------------------------------------
   Base
   -------------------------------------------------------------------------- */
*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    /* Keep anchored sections clear of the floating dock */
    scroll-padding-bottom: 8rem;
